<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Orange Pi Terminal</vendor>
  <action id="com.orangepi.terminal.network-policy">
    <description>Modify built-in application network policy</description>
    <message>Authentication is required to change which built-in applications may access the network.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">@NET_POLICY_HELPER_INSTALL_PATH@</annotate>
  </action>
</policyconfig>
