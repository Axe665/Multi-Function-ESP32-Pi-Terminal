            "unit": "kg"
          },
          "x": {
            "type": "double",
            "unit": "cm"
          },
          "y": {
            "type": "double",
            "unit": "cm"
          },
          "bw": {
            "type": "double",
            "unit": "cm"
          },
          "bl": {
            "type": "double",
            "unit": "cm"
          },
          "em": {
            "type": "double",
            "unit": "cm"
          },
          "state": {
            "type": "string"
          },
          "out_ms": {
            "type": "int",
            "unit": "ms"
          },
          "in_ms": {
            "type": "int",
            "unit": "ms"
          },
          "mov": {
            "type": "double"
          },
          "evt": {
            "type": "int"
          },
          "event": {
            "type": "string"
          },
          "night": {
            "type": "bool"
          },
          "fault": {
            "type": "int"
          },
          "received_at": {
            "type": "int",
            "unit": "ms"
          },
          "v": {
            "type": "int"
          },
          "present": {
            "type": "bool"
          },
          "cal": {
            "type": "string"
          },
          "cw": {
            "type": "double",
            "unit": "kg"
          },
          "t": {
            "type": "int",
            "unit": "ms"
          }
        }
