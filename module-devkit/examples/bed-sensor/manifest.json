{
  "id": "bed.guardian",
  "name": "床边守护",
  "version": "0.1.0",
  "module_id": 84,
  "package_id": "bed.guardian-0.1.0-arm64",
  "package_version": "0.1.0",
  "host_arch": [
    "aarch64",
    "arm64"
  ],
  "library": "libmodule.so",
  "qml_page": "qml/ModulePage.qml",
  "abi_version": 1,
  "min_host_api": 3,
  "qt_major": 6,
  "platform_api": 2,
  "network_api": "none",
  "file_api": "none",
  "unload_contract": "synchronous-stop-v1",
  "max_payload": 65532,
  "control_protocol": "pogo-control-v1",
  "data_protocol": "bed-guardian-v1",
  "capabilities": [
    "bed.weight",
    "bed.position",
    "bed.events"
  ],
  "permissions": [
    "transport.ble"
