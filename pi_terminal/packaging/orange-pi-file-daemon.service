[Unit]
Description=Orange Pi Terminal per-user file API daemon
Documentation=file:///usr/share/doc/orange-pi-terminal/files-api.md

[Service]
Type=simple
# 宿主在启动前生成 0600 token 文件；daemon 只接受带同一 token 的宿主请求。
ExecStart=/usr/bin/orange-pi-file-daemon --socket=%t/orange-pi-file.sock --token-file=%t/orange-pi-file.token
Restart=on-failure
RestartSec=1
# 家目录只读；仅本应用的 apps 数据目录可写，敏感目录由 daemon 代码拒绝。
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/orange-pi-terminal/apps
PrivateTmp=yes
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=default.target
