pragma Singleton
import QtQuick

QtObject {
    readonly property bool english: systemTools.uiLanguage === "en"
    function t(text) {
        if(!english || !text)return text
        if(words[text]!==undefined)return words[text]
        let result=text
        const keys=Object.keys(words).filter(function(key){return key.length>2}).sort(function(a,b){return b.length-a.length})
        for(let key of keys)if(result.indexOf(key)>=0)result=result.split(key).join(words[key])
        return result
    }
